# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJkLmNoPQRstUVwxyZ

# Numeric ID of your Supergroup (typically begins with -100)
# Find it by forwarding a message from the group to @JsonDumpBot or @userinfobot
TARGET_GROUP_ID=-1001234567890

# Optional: Private Admin Log Channel ID (begins with -100)
LOG_CHANNEL_ID=0

# Number of vouches needed to bail out a jailed member (default: 3)
BAIL_THRESHOLD=3

# Verification timeout in seconds (default: 90)
CAPTCHA_TIMEOUT=90

# Anti-Raid Threshold: Maximum joins within RAID_WINDOW before lockdown
RAID_THRESHOLD=5
RAID_WINDOW=10

# Duration of Anti-Raid lockdown in seconds (default: 300 = 5 minutes)
LOCKDOWN_DURATION=300
