# Telegram Bot API Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJkLmNoPQRstUVwxyZ

# Multi-Tenant Operation:
# You can add the bot to multiple supergroups. Each group's admin can configure
# settings directly in the chat using `/settings` and `/setlog <channel_id>`.
#
# Below are global fallback defaults used if a group has not customized a setting:

# Optional: Default target group (0 = multi-tenant mode for any group where added)
TARGET_GROUP_ID=0

# Optional: Default log channel (0 = disabled unless configured per-group via /setlog)
LOG_CHANNEL_ID=0

# Default number of vouches needed to bail out an inmate (1-5, default: 3)
BAIL_THRESHOLD=3

# Default Emoji CAPTCHA verification timeout in seconds (default: 90)
CAPTCHA_TIMEOUT=90

# Default Anti-Raid Threshold: joins within RAID_WINDOW before panic lockdown
RAID_THRESHOLD=5
RAID_WINDOW=10

# Default panic lockdown duration in seconds (default: 300 = 5 minutes)
LOCKDOWN_DURATION=300

